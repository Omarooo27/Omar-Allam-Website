---
import '../styles/global.css';
import { site } from '../config/site';
interface Props { title?: string; description?: string; pageClass?: string; }
const {
  title = 'Omar Allam — Electrical Engineering',
  description = 'CPU telemetry firmware at Qualcomm, autonomous systems at Queen’s, and RTL projects focused on computer architecture.',
  pageClass = '',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d10" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="/" aria-label="Omar Allam home"><span class="brand-mark">oa.</span> Omar Allam</a>
        <nav aria-label="Main navigation">
          <a href="/#projects">Projects</a>
          <a href="/#experience">Experience</a>
          <a href="/#contact">Contact</a>
          <a class="nav-resume" href={site.resume} target="_blank" rel="noopener noreferrer">Resume <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main" class={pageClass}><slot /></main>
    <footer class="container footer">
      <span>© {new Date().getFullYear()} Omar Allam</span>
      <a href="#main">Back to top ↑</a>
    </footer>
  </body>
</html>
